# Leave as replace-me to run without a provider: the API answers 503 and the browser example still works.
OPENAI_API_KEY=replace-me
# Chat model used for suggestions.
OPENAI_MODEL=gpt-4o-mini
# SQLite file that records each prompt and reply. Set it empty to turn the log off.
# PROMPT_LOG_PATH=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
